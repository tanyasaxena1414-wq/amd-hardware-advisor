# AMD Hardware Advisor — environment template.
# Copy to .env and fill in real values. NEVER commit real API keys.
# AMD provider details are UNVERIFIED at planning time — confirm during P6.

# ---- Inference provider selection ----
# token_factory | dev_cloud | ollama
LLM_PROVIDER=token_factory

# ---- Embeddings (always local for MVP; no external embedding endpoint) ----
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- AMD Token Factory (PRIMARY, UNVERIFIED) ----
# Confirm endpoint, auth, and models by signing in at notebooks.amd.com/tokenfactory during P6.
AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_TOKEN_FACTORY_API_KEY=rc-d84786ef641eae0cc92c80b9a7f92027a3f949b541fc6b9b
AMD_TOKEN_FACTORY_MODEL=DeepSeek-V4-Flash

# ---- AMD Developer Cloud vLLM (OpenAI-compatible, alternate AMD path) ----
# Requires registration/approval (24-48h lead time).
AMD_DEV_CLOUD_BASE_URL=
AMD_DEV_CLOUD_API_KEY=
AMD_DEV_CLOUD_MODEL=

# ---- Local Ollama fallback (default MVP provider) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# ---- Retrieval / chunking (tune later) ----
TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ---- Logging ----
LOG_LEVEL=INFO
